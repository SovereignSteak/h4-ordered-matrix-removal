H4Formal.arbitrary_edit_lower_bound (h : ℕ) (hh : 1 ≤ h)
  (D : H4Formal.PhysicalPosition h → H4Formal.PhysicalPosition h → Bool)
  (edits : List (H4Formal.PhysicalPosition h × H4Formal.PhysicalPosition h))
  (covers : ∀ (r c : H4Formal.PhysicalPosition h), D r c ≠ H4Formal.hostValue h r.block c.block → (r, c) ∈ edits)
  (hf : H4Formal.PatternFree (H4Formal.editedHost h D)) : 2 ^ h * 2 ^ h ≤ edits.length
H4Formal.end_to_end_main_theorem :
  (∀ (h : ℕ),
      1 ≤ h →
        H4Formal.TerminalExhaustion h ∧
          H4Formal.PatternFree (H4Formal.standardHost h true) ∧
            H4Formal.hostSize h = (14 * h + 2) * 2 ^ h ∧
              H4Formal.hostCopyCount h = 2 * (2 ^ h) ^ 6 + (2 ^ h - 2) / 2 * (2 ^ h) ^ 5 ∧
                H4Formal.editDistance (H4Formal.standardHost h) = 2 ^ h * 2 ^ h ∧
                  H4Formal.distanceDensity h = H4Formal.epsilon h) ∧
    Filter.Tendsto H4Formal.hostSize Filter.atTop Filter.atTop ∧
      Filter.Tendsto H4Formal.epsilon Filter.atTop (nhds 0) ∧
        (∀ (C : ℝ), Filter.Tendsto (fun h => H4Formal.copyDensity h / H4Formal.epsilon h ^ C) Filter.atTop (nhds 0)) ∧
          ∀ (c C : ℝ), 0 < c → 0 < C → ¬H4Formal.PolynomialRemovalBound c C
